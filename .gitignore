node_modules/
dist/
*.local
.DS_Store
coverage/

# Playwright: the config points outputDir at node_modules/.cache, but the HTML
# reporter and the default outputDir both write here if anyone enables them.
playwright-report/
test-results/
blob-report/
.playwright/

# Vendored AI tooling, not project source. Reinstall with:
#   npx ui-ux-pro-max-cli init --ai claude
.claude/skills/
__pycache__/

# Local environment. A Firebase web config is not a secret (it ships in the
# client bundle either way — access is controlled by Security Rules and the
# authorized-domains list), but it is per-environment, so it stays out of git.
.env
.env.*
!.env.example
